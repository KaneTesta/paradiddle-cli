# Copy this file to .env beside Start.cmd.
# Set the full path to your existing Paradiddle Songs folder (not its parent).
# Example on Windows:
# PARADIDDLE_SONGS_DIR="C:\Users\YourName\Documents\Paradiddle\Songs"
# %USERPROFILE% and ~ are supported. Leave blank to disable automatic copying.
PARADIDDLE_SONGS_DIR=
